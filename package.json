{
  "name": "grist-widget",
  "version": "0.0.2",
  "type": "module",
  "description": "A repository of grist custom widgets that have no back-end requirements.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node ./buildtools/publish.js manifest.json",
    "serve": "vite preview --port 8585",
    "lint": "ts-standard",
    "lint:fix": "ts-standard --fix"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "daisyui": "^5.1.3",
    "glob": "^11.0.3",
    "node-ray": "^2.1.2",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "ts-standard": "^12.0.2",
    "vite": "^7.1.4"
  },
  "dependencies": {
    "@tiptap/core": "^3.3.0",
    "@tiptap/extension-bubble-menu": "^3.3.0",
    "@tiptap/extension-underline": "^3.3.0",
    "@tiptap/starter-kit": "^3.3.0"
  },
  "ts-standard": {
    "project": "./tsconfig.json",
    "globals": [
      "grist"
    ]
  }
}
